# Domeniu care arată spre IP-ul public al serverului din Moldova (înregistrare DNS de tip A)
LIVEKIT_DOMAIN=apeluri.exemplu.md

# Generează-le o singură dată:
#   LIVEKIT_API_KEY:    echo "API$(openssl rand -hex 6)"
#   LIVEKIT_API_SECRET: openssl rand -base64 36
# Aceleași valori se pun și ca secrete ale Edge Function-ului (vezi chat/README.md).
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
